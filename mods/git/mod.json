{
  "place": "none",
  "focusable": true,
  "lib": [
    "git.js",
    "filetype.js",
    "open.js",
    "location.js",
    "space-locks.js",
    "editor.js",
    "edit-open.js"
  ],
  "palette": [
    {
      "title": "Git: open beside",
      "command": "pane.split",
      "args": {
        "direction": "right",
        "mod": "git"
      },
      "words": "lazygit changes worktrees"
    },
    {
      "title": "Git: larger text",
      "command": "git.font-bigger",
      "words": "git font size text bigger zoom"
    },
    {
      "title": "Git: smaller text",
      "command": "git.font-smaller",
      "words": "git font size text smaller zoom"
    },
    {
      "title": "Git: default text size",
      "command": "git.font-reset",
      "words": "git font size text reset"
    }
  ]
}
